<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built and run inside the n8n container by the 'DotNet Migration Package API' workflow.
       No package references: System.Reflection.Metadata ships with the runtime, so it
       builds offline. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
