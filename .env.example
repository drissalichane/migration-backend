# Copy this file to .env (same folder) and fill in the values. Never commit .env.
# README.md explains where each one comes from.

# OpenRouter API key - the LLMs the pipeline calls. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# A GitHub OAuth app, used to sign in to the dashboard and open pull requests.
# Callback URL when creating it: http://localhost:5153/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Any long random text (32+ characters). It signs the dashboard's login sessions.
JWT_KEY=

# Optional. An n8n API key (n8n -> Settings -> n8n API) lets the job page show measured
# token counts and timings. Leave empty at first; add it after creating your n8n account.
N8N_API_KEY=

# Optional. Where the dashboard repository is, relative to this folder.
# DASHBOARD_DIR=../migration_dashboard
